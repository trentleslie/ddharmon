# Environment variables for ddharmon.
# Copy this to .env and fill in your values.

# =============================================================================
# LLM provider (for the classify-only adopt/refine/novel pass + optional rerank)
# =============================================================================
# Anthropic — used for the harmonization classify pass (sync or Batch API).
# Get a key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-key-here

# OpenAI — optional; only if you select OpenAI embeddings or LLM reranking.
# Get a key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-key-here

# Provider selection. Options: anthropic | openai
LLM_PROVIDER=anthropic

# =============================================================================
# Embedding provider
# =============================================================================
# Options: sentence-transformers (default, runs locally, no key) | openai | voyageai
EMBEDDING_PROVIDER=sentence-transformers

# VoyageAI — optional; only if EMBEDDING_PROVIDER=voyageai.
VOYAGE_API_KEY=your-voyage-key-here
